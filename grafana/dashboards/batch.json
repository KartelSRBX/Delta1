          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT provider, game_id AS game, sum(rounds) AS rounds, sum(ggr_eur) AS ggr, 1 - sum(ggr_eur) / sum(turnover_eur) AS rtp FROM delta1.provider_daily WHERE day = today() GROUP BY provider, game ORDER BY ggr DESC",
