      "id": 6,
      "type": "timeseries",
      "title": "Produced vs consumed vs accepted",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(delta1_generator_events_total[1m]))",
          "legendFormat": "produced",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(delta1_processor_consumed_total[1m]))",
          "legendFormat": "consumed",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(delta1_processor_accepted_total[1m]))",
          "legendFormat": "accepted",
          "refId": "C"
