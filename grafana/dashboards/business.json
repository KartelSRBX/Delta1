    {
      "id": 16,
      "type": "table",
      "title": "Settled bets by sport",
      "description": "Hold = 1 - payout / stake. The simulator prices bets with a 6% margin.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 6,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sport, sum(bets) AS settled, sumIf(bets, status = 'won') / sum(bets) AS win_rate, sum(toFloat64(stake) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency))) AS stake_eur, sum(toFloat64(payout) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency))) AS payout_eur, 1 - sum(toFloat64(payout) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency))) / sum(toFloat64(stake) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency))) AS hold FROM delta1.sport_ggr_1m WHERE $__timeFilter(minute) GROUP BY sport ORDER BY stake_eur DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "win_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "displayName",
                "value": "Win rate"
              }
            ]
          },
