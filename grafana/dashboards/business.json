    {
      "id": 12,
      "type": "table",
      "title": "Top games: actual vs theoretical RTP",
      "description": "Large positive deltas mean a game paid out more than its math model. In production that is the first thing to check with the provider.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT g.title AS game, a.provider AS provider, a.n_rounds AS rounds, a.t_eur AS turnover_eur, a.t_eur - a.p_eur AS ggr_eur, a.p_eur / a.t_eur AS rtp_actual, g.rtp AS rtp_theoretical, a.p_eur / a.t_eur - g.rtp AS rtp_delta FROM ( SELECT game_id, provider, sum(rounds) AS n_rounds, sum(toFloat64(turnover) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency))) AS t_eur, sum(toFloat64(payout) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency))) AS p_eur FROM delta1.casino_ggr_1m WHERE $__timeFilter(minute) GROUP BY game_id, provider ) AS a LEFT JOIN delta1.games AS g ON g.game_id = a.game_id ORDER BY turnover_eur DESC LIMIT 12",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
