          "rawSql": "SELECT time, vertical, turnover_eur FROM ( SELECT minute AS time, 'casino' AS vertical, sum(toFloat64(turnover) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency))) AS turnover_eur FROM delta1.casino_ggr_1m WHERE $__timeFilter(minute) GROUP BY time UNION ALL SELECT minute AS time, 'sportsbook' AS vertical, sum(toFloat64(stake) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency))) AS turnover_eur FROM delta1.sport_ggr_1m WHERE $__timeFilter(minute) GROUP BY time ) ORDER BY time",
