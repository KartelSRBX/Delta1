    {
      "id": 9,
      "type": "timeseries",
      "title": "GGR per minute by brand (casino + sportsbook)",
      "description": "Casino GGR is volatile minute to minute: a single big win can push it negative. Sportsbook GGR is booked when bets settle.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT minute AS time, brand, sum(ggr) AS ggr FROM ( SELECT minute, brand, toFloat64(turnover - payout) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency)) AS ggr FROM delta1.casino_ggr_1m WHERE $__timeFilter(minute) UNION ALL SELECT minute, brand, toFloat64(stake - payout) * dictGet('delta1.fx_dict', 'rate_to_eur', tuple(currency)) AS ggr FROM delta1.sport_ggr_1m WHERE $__timeFilter(minute) ) GROUP BY time, brand ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 35,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "currencyEUR",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
